VKC_ENVIRONMENT=development
VKC_HOST=127.0.0.1
VKC_PORT=8000
VKC_LOG_LEVEL=INFO
VKC_DATABASE_URL=sqlite+aiosqlite:///./data/app.db
VKC_STORAGE_ROOT=./storage
VKC_WORKER_POLL_INTERVAL_SECONDS=1.0
VKC_WORKER_LEASE_SECONDS=15.0
VKC_DEMO_STAGE_DELAY_SECONDS=0.35
VKC_YT_DLP_COOKIES_FILE=
VKC_DOWNLOAD_PROXY=
VKC_DOWNLOAD_MAX_VIDEO_HEIGHT=1080

# Reserved messaging admission policy; Stage 0 does not register write tools.
# Desktop ingestion is unaffected. Lists use JSON syntax.
VKC_MESSAGING_INGEST_ENABLED=false
VKC_MESSAGING_ALLOWED_PLATFORMS=["feishu"]
VKC_MESSAGING_MAX_ACTIVE_PER_USER=1
VKC_MESSAGING_MAX_SUBMISSIONS_PER_USER_PER_DAY=10
VKC_MESSAGING_MAX_VIDEO_DURATION_SECONDS=1800
VKC_MESSAGING_MAX_VIDEO_HEIGHT=720
VKC_FFPROBE_PATH=ffprobe
VKC_FFMPEG_PATH=ffmpeg
VKC_ASR_ENABLED=true
VKC_ASR_MODEL=small
VKC_ASR_DEVICE=auto
VKC_ASR_COMPUTE_TYPE=auto
VKC_ASR_VAD_FILTER=true
VKC_ASR_WORD_TIMESTAMPS=false
VKC_ASR_CHUNK_SECONDS=120
VKC_ASR_OVERLAP_SECONDS=1.5
VKC_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
VITE_API_BASE_URL=
